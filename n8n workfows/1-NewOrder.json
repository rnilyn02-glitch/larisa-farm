    {
      "parameters": {
        "jsCode": "// n8n Code Node (JavaScript)\n// Извлекаем полезную нагрузку из обертки n8n Webhook\nconst data = $input.first().json.body;\n\n// 1. Валидация клиента\nif (!data.customer || !data.customer.phone) {\n  throw new Error('Missing required field: customer.phone');\n}\n\n// 2. Валидация товаров\nif (!data.items || !Array.isArray(data.items) || data.items.length === 0) {\n  throw new Error('Order is empty or items not specified');\n}\n\n// 3. Валидация каждого товара\nfor (const item of data.items) {\n  if (!item.product_id) {\n    throw new Error(`Missing product_id in item: ${JSON.stringify(item)}`);\n  }\n  if (typeof item.quantity !== 'number' || item.quantity <= 0) {\n    throw new Error(`Invalid quantity for product ${item.product_id}: ${item.quantity}`);\n  }\n  if (typeof item.price_at_moment !== 'number' || item.price_at_moment < 0) {\n    throw new Error(`Invalid price for product ${item.product_id}`);\n  }\n}\n\n// 4. Расчет предварительной суммы\nconst preliminaryTotal = data.items.reduce((sum, item) => {\n  return sum + (item.price_at_moment * item.quantity);\n}, 0);\n\n// 5. Возвращаем обогащенные данные\n// Важно: возвращаем структуру, которую ждут следующие ноды\nreturn {\n  json: {\n    ...data,  // Распаковываем исходный body, чтобы дальше работать с customer, items и т.д.\n    preliminary_total: preliminaryTotal,\n    received_at: new Date().toISOString(),\n    normalized_phone: data.customer.phone.replace(/[^\\d+]/g, '')\n  }\n};"
      },
