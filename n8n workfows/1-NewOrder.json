    {
      "parameters": {
        "jsCode": "// Извлекаем ошибку из структуры n8n\nconst error = $input.first().json.error || $input.first().json;\n\n// Определяем код ошибки по тексту сообщения\nlet errorCode = 'UNKNOWN_ERROR';\nconst msg = error.message || '';\n\nif (msg.includes('customer.phone')) errorCode = 'MISSING_PHONE';\nelse if (msg.includes('items')) errorCode = 'INVALID_ITEMS';\nelse if (msg.includes('product_id')) errorCode = 'MISSING_PRODUCT_ID';\nelse if (msg.includes('quantity')) errorCode = 'INVALID_QUANTITY';\nelse if (msg.includes('price')) errorCode = 'INVALID_PRICE';\n\n// Возвращаем чистый формат для Respond to Webhook\nreturn {\n  json: {\n    success: false,\n    error: {\n      message: msg || 'Validation failed',\n      code: errorCode,\n      timestamp: new Date().toISOString()\n    }\n  }\n};"
      },
